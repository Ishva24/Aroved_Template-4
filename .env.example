# Optional: deliver enquiry-form submissions by email via Resend (https://resend.com).
# Without these, the form falls back to opening the visitor's email client addressed to sales@aroved.com.
RESEND_API_KEY=
ENQUIRY_FROM="AROSAFE Website <website@your-verified-domain.com>"
ENQUIRY_TO=sales@aroved.com
NEXT_PUBLIC_SITE_URL=https://aroved.com
